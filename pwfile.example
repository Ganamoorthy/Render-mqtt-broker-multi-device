# ==============================================================================
# Mosquitto Password File Example (pwfile.example)
# DO NOT USE AS-IS IN PRODUCTION!
# ==============================================================================
# This file illustrates the format expected by Eclipse Mosquitto.
# Real passwords must be hashed using the 'mosquitto_passwd' command-line utility.
# Format: <username>:<hashed_password>
#
# Generating a password file locally using Docker:
#   docker run --rm -it -v ${PWD}:/work -w /work eclipse-mosquitto:latest \
#     mosquitto_passwd -c -b pwfile my_device_01 my_secure_password
#
# Adding additional devices/users to an existing pwfile:
#   docker run --rm -it -v ${PWD}:/work -w /work eclipse-mosquitto:latest \
#     mosquitto_passwd -b pwfile my_device_02 another_secure_password
#
# TIP: On Render, you can also use Environment Variables (MQTT_DEVICES or
# MQTT_USERNAME & MQTT_PASSWORD) to auto-generate this file at boot!
# ==============================================================================

# Administrator / Dashboard accounts
admin:$7$101$2oG5V3m9j4k7q1wX$R5o2t9Y1kL9m8N7v6c5X4z3a2B1C0D9e8F7g6H5i4J3k2L1m0N9O8P7q6R5S4T3u2V1W0X9y8Z7a6B5c4d3==
dashboard:$7$101$8pK2m1v4n5b6c7xZ$Q4w3e2r1t0y9u8i7o6p5a4s3d2f1g0h9j8k7l6z5x4c3v2b1n0m9Q8W7E6R5T4Y3U2I1O0P9A8S7D6==

# IoT Device accounts (Username matches Device ID)
esp32_device_01:$7$101$5xT8y2u3i4o5p6a7$M9n8b7v6c5x4z3a2s1d0f9g8h7j6k5l4q3w2e1r0t9y8u7i6o5p4a3s2d1f0g9h8j7k6l5==
sensor_node_02:$7$101$9qW1e2r3t4y5u6i7$Z8x7c6v5b4n3m2l1k0j9h8g7f6d5s4a3p2o1i0u9y8t7r6e5w4q3a2s1d0f9g8h7j6k5l4==
